# SOLVI ローカル開発用の設定例。`cp .env.example .env` してから値を埋める。
# 実際の .env はコミットしない(.gitignore 済み / AGENTS.md §1.8)。
# 既定値は意図的に用意していない。未設定のまま起動すると各サービスは起動時に失敗する。

# ---- PostgreSQL ----
POSTGRES_DB=solvi
POSTGRES_PORT=5433
# 管理用(マイグレーション実行のみに使う)
POSTGRES_SUPERUSER=solvi_owner
POSTGRES_SUPERUSER_PASSWORD=change-me-local-only
# アプリケーション用。非owner・NOBYPASSRLS(ADR-0015 / WP-P1-DATA-002)
POSTGRES_APP_USER=solvi_app
POSTGRES_APP_PASSWORD=change-me-local-only
# Executor 用。Core とは別の資格情報(ADR-0006)
POSTGRES_EXECUTOR_USER=solvi_executor
POSTGRES_EXECUTOR_PASSWORD=change-me-local-only

# ホストから実行するツール(マイグレーション等)が使う接続文字列
DATABASE_URL=postgres://solvi_app:change-me-local-only@127.0.0.1:5433/solvi
DATABASE_ADMIN_URL=postgres://solvi_owner:change-me-local-only@127.0.0.1:5433/solvi

# ---- Object Storage (MinIO / 本番は S3) ----
S3_ENDPOINT=http://127.0.0.1:9100
S3_PORT=9100
S3_CONSOLE_PORT=9101
S3_REGION=ap-northeast-1
S3_BUCKET_ATTACHMENTS=solvi-attachments
S3_BUCKET_AUDIT_ANCHOR=solvi-audit-anchor
S3_ACCESS_KEY=solvi-local-access
S3_SECRET_KEY=change-me-local-only

# ---- サービスポート ----
WEB_PORT=3000
API_PORT=3001
WORKER_PORT=3002
AI_PORT=3004

# ---- 可観測性 ----
LOG_LEVEL=info
# ローカルは Jaeger(docker compose)。空にすると計装だけ有効でエクスポートしない。
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAMESPACE=solvi
JAEGER_UI_PORT=16686
OTLP_HTTP_PORT=4318

# ---- 認証 (WP-P1-IDM-003 で使用) ----
# Okta テストテナントの値。本番テナントの値をローカルへ入れない。
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# ---------------------------------------------------------------------------
# 検証段階のローカル認証 (ADR-0019 / WP-P1-IDM-009)
#
# **本番では有効にできない。** NODE_ENV=production かつ true だと
# プロセスが起動を拒否する(脅威 T-25)。
# ---------------------------------------------------------------------------
AUTH_LOCAL_ENABLED=true
# ローカルHTTP開発では Secure を付けられない。本番では false にできない。
SESSION_COOKIE_SECURE=false
# 1プロセスあたりのDB接続プール (NFR-PERF-001)。
# **プロセス数 × この値 ≤ PostgreSQL の max_connections(既定100)**。
PG_POOL_MAX=10

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900

# 失効・期限切れセッションを保持する日数 (03.16 / WP-P1-IDM-013)。
# **数値の根拠はまだ無い。** 法務・監査の確認がつくまでの仮の値である。
SESSION_RETENTION_DAYS=30

# アクセスレビューの完了期日。開始からの日数 (NFR-SEC-002 / WP-P1-SEC-025)。
# **30日は仮値である。** 要求文書に数字が無い。四半期より短くする(1〜89)。
ACCESS_REVIEW_DUE_DAYS=30

# ---------------------------------------------------------------------------
# 合成監視 (WP-P2-SLO-008)
#
# 専用アカウントを使う。実在の利用者を使い回すと、その人が無効化された
# 瞬間に監視が落ちる。未設定なら login / ticket_create は「未実行」として
# 公開され、成功扱いにはならない。
# ---------------------------------------------------------------------------
SYNTHETIC_EMAIL=
SYNTHETIC_PASSWORD=
SYNTHETIC_ORG=
